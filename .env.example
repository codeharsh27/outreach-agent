# ============================================================
# OUTREACH AGENT — Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit .env to git
# ============================================================

# --- GitHub (for research agent - 5000 req/hour) ---
GITHUB_TOKEN=your_github_token_here

# --- Contact Finding APIs (sign up with personal Gmail) ---
HUNTER_API_KEY=your_hunter_key_here
SNOVIO_USER_ID=your_snovio_user_id
SNOVIO_SECRET=your_snovio_secret
MINELEAD_API_KEY=your_minelead_key_here

# --- Gmail API (for sending) ---
GMAIL_SENDER_EMAIL=harshmule.builds@gmail.com
# credentials.json path (downloaded from Google Cloud Console)
GMAIL_CREDENTIALS_PATH=./config/gmail_credentials.json

# --- Ollama (local model) ---
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:3b

# --- Hermes / Telegram ---
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_chat_id

# --- Your identity (used in all drafts) ---
YOUR_NAME=Harsh Mule
YOUR_EMAIL=harshmule.builds@gmail.com
SIDEDOOR_URL=https://sidedoor-chi.vercel.app/
PORTFOLIO_URL=https://harshmule.vercel.app/
TWITTER_URL=https://x.com/codeharsh27
LINKEDIN_URL=https://www.linkedin.com/in/harshmule27/
GITHUB_URL=https://github.com/codeharsh27
